# Copier vers .env puis remplacer chaque valeur CHANGE_ME par un secret aléatoire distinct.
DJANGO_SETTINGS_MODULE=kozons.settings.dev
KOZONS_ENVIRONMENT=dev
DJANGO_SECRET_KEY=CHANGE_ME_64_RANDOM_CHARACTERS
JWT_SIGNING_KEY=CHANGE_ME_DIFFERENT_64_RANDOM_CHARACTERS
RATE_LIMIT_SECRET=CHANGE_ME_DIFFERENT_64_RANDOM_CHARACTERS
MEDIA_PATH_HMAC_SECRET=CHANGE_ME_DIFFERENT_64_RANDOM_CHARACTERS
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Profil local uniquement : origines supplémentaires autorisées sur le réseau privé.
KOZONS_LOCAL_NETWORK_ORIGINS=http://192.168.1.3:3000
DRF_NUM_PROXIES=0

POSTGRES_DB=kozons
POSTGRES_USER=kozons
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://kozons:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/kozons
DB_SSLMODE=prefer

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0
CACHE_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/1
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/2
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/3

JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=30
JWT_REFRESH_COOKIE_NAME=kozons_refresh
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_SAMESITE=Strict
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
MESSAGE_DELETE_FOR_EVERYONE_HOURS=48
# Profil local seulement : true génère un OTP aléatoire destiné à un fournisseur réel.
KOZONS_USE_RANDOM_OTP=false

# SMTP (exemple Gmail : smtp.gmail.com, port 587, TLS=true).
# Utiliser un mot de passe d'application dans .env, jamais le mot de passe principal.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=CHANGE_ME_SENDER_EMAIL
EMAIL_HOST_PASSWORD=CHANGE_ME_APP_PASSWORD
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=CHANGE_ME_SENDER_EMAIL

SMS_PROVIDER=users.sms.ConsoleSMSProvider
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
AWS_ACCESS_KEY_ID=CHANGE_ME_MINIO_USER
AWS_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD
AWS_STORAGE_BUCKET_NAME=kozons-dev
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_PRESIGNED_EXPIRY=300

CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=120
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_ADMIN_EMAIL=security@example.test
